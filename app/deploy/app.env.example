# /opt/tenders/app.env  (chmod 600). Never commit the real file.
DATABASE_URL=postgresql+psycopg://tw:CHANGE_ME@127.0.0.1:5442/tw
SECRET_KEY=            # python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DATA_DIR=/opt/tenders/app-data
BOARD_JSON=/opt/tenders/site/tenders.json
ENTRY_BOT_PY=/opt/tenders/entry_bot.py
SITE_URL=https://tenders.sonador.et
ANTHROPIC_API_KEY=     # same key as the entry bot
SECURE_COOKIES=1
TELEGRAM_BOT_TOKEN=    # same token as the entry bot; the app sends the morning alerts
TELEGRAM_BOT_USERNAME=tender_watcher_entry_bot
INTERNAL_SECRET=       # random; the same value goes in entry-bot.env, with APP_URL=http://127.0.0.1:8700
CHAPA_SECRET_KEY=      # Sonador's Chapa key; copy it from entry-bot.env (test key until Robel says go live)

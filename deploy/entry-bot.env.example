# Copy to /opt/tenders/entry-bot.env, fill in, then: chmod 600 /opt/tenders/entry-bot.env
# Never commit the real file or paste these values in chat.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Telegram IDs (numbers). Anyone can get theirs by sending /start to the bot.
REVIEWER_IDS=
COLLECTOR_IDS=
BOARD_JSON=/opt/tenders/site/tenders.json
STATE_DIR=/opt/tenders/bot
NOTICES_DIR=/opt/tenders/site/notices
NOTICES_URL=/notices
# Buyer websites to check once a day (leave empty to turn the watcher off), and the hour (Addis time).
SOURCES_JSON=/opt/tenders/sources.json
WATCH_HOUR=6
# Subscriber alerts: hour (Addis time) for the daily Telegram list of new matching tenders.
ALERT_HOUR=8
SITE_URL=https://tenders.sonador.et
